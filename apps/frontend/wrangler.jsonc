{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lisergia",
  "main": "worker.ts",
  "minify": true,
  "alias": {
    // Vite build manifest (see `templates/manifest.ts`). Requires `lisergia build` first.
    "lisergia:manifest": "./build/.vite/manifest.json"
  },
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build"
  },
  "routes": [
    {
      "pattern": "lisergia.dev",
      "custom_domain": true
    }
  ],
  "dev": {
    "port": 8787
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}

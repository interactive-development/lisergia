{
  "name": "lisergia-frontend",
  "private": true,
  "version": "24.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun run --parallel dev:assets dev:worker",
    "dev:assets": "lisergia dev",
    "dev:worker": "wrangler dev --live-reload --env-file ../../.env",
    "build": "bun run build:client",
    "build:client": "lisergia build",
    "check-types": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy --keep-vars",
    "lint": "biome check .",
    "types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --include-runtime false"
  },
  "dependencies": {
    "@posthog/types": "^1.407.1",
    "elysia": "^1.4.30",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@lisergia/cli": "27.0.0",
    "@lisergia/config-stylelint": "27.0.0",
    "@lisergia/config-tsconfig": "27.0.0",
    "@lisergia/core": "27.0.0",
    "@lisergia/managers": "27.0.0",
    "@lisergia/styles": "27.0.0",
    "@lisergia/utilities": "27.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
